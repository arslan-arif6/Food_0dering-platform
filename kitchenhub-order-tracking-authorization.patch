     const supabase = createServiceRoleClient();

     const { data, error } = await supabase
         .from("orders")
         .select(`
-            *,
+            id,
+            customer_name,
+            phone,
+            address,
+            payment_method,
+            status,
+            total,
             order_items (
-                *
+                id,
+                dish_name,
+                variant_name,
+                quantity,
+                line_total
             )
         `)
         .eq("id", id)
         .single();

-    if (error) {
-        console.error(error);
+    if (error || !data) {
         return null;
     }

+    const storedPhone = String(data.phone ?? "").replace(/\D/g, "");
+    if (!storedPhone || storedPhone !== normalizedPhone) {
+        return null;
+    }
+
     return data;
 }
